{
  "manifest_version": 3,
  "name": "Media Hub",
  "version": "1.0.0",
  "description": "Dashboard unificado de Letterboxd, Backloggd e Skoob, com busca e criação rápida de reviews.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://backloggd.com/*",
    "https://www.backloggd.com/*",
    "https://www.skoob.com.br/*",
    "https://skoob.com.br/*",
    "https://www.googleapis.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Abrir Media Hub" },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*",
        "https://backloggd.com/*",
        "https://www.backloggd.com/*",
        "https://www.skoob.com.br/*",
        "https://skoob.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "media-hub@local", "strict_min_version": "115.0" }
  }
}
